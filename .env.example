# Copy this file to .env and fill in real values.
# .env is gitignored — never commit secrets.

# Required: surfaced in User-Agent for polite-crawler identification.
CONTACT_EMAIL=your-email@example.com

# Required: Discord webhook for run notifications.
# Generate at: Discord server → Channel settings → Integrations → Webhooks.
DISCORD_WEBHOOK_URL=

# Optional: override DCAD bulk-data year.
# DCAD_TARGET_YEAR=2026

# Optional: override default lookback window (default 7).
# DAYS_BACK_OVERRIDE=14

# Optional: override local cache directory.
# DCAD_CACHE_DIR=/tmp/dcad_cache
